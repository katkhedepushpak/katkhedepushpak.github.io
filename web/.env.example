# Generate these at https://giscus.app after enabling Discussions on the repo
# and installing the giscus GitHub App. Copy this file to .env.local for local
# dev, and add the same values as repo Variables (Settings > Secrets and
# variables > Actions > Variables) so the GitHub Actions build picks them up.
VITE_GISCUS_REPO=katkhedepushpak/katkhedepushpak.github.io
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY=General
VITE_GISCUS_CATEGORY_ID=
